# ── Clerk (frontend) ───────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── Backend API ────────────────────────────────────────
# The frontend proxies /api/* to the backend (see next.config.ts and middleware.ts),
# so the browser talks to the backend same-origin. In production this MUST be the
# public backend origin (e.g. https://postpilot-ha3f.onrender.com), not localhost.
BACKEND_INTERNAL_URL=http://localhost:5000
# Optional: set to bypass the proxy and call the backend directly (not same-origin).
# NEXT_PUBLIC_API_URL=

# ── Site ───────────────────────────────────────────────
# Public site origin, used for metadata (Open Graph), sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://postpilot.app

# ── Builder.io (optional) ──────────────────────────────
NEXT_PUBLIC_BUILDER_API_KEY=
